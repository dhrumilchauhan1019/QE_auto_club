generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  executive
  manager
  closer
  finance
  caller
}

enum Stage {
  lead
  contacted
  decision_maker_reached
  appointment
  presentation
  proposal
  contract
  payment
  completed
  closed_lost
  do_not_contact
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(caller)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignedProspects Prospect[]     @relation("AssignedCaller")
  backupProspects   Prospect[]     @relation("BackupCaller")
  closerProspects   Prospect[]     @relation("AssignedCloser")
  managedProspects  Prospect[]     @relation("SupervisingManager")
  activities        Activity[]
  notifications     Notification[]
  logs              ActivityLog[]
  csvImports        CsvImport[]
  overrides         ScoreHistory[]
}

model Prospect {
  id                    String    @id @default(uuid())
  businessName          String
  industry              String?
  website               String?
  address               String?
  city                  String?
  county                String?
  state                 String?
  zip                   String?
  leadSource            String?
  decisionMaker         String?
  decisionMakerPosition String?
  phone                 String?
  email                 String?
  vehicleCount          Int       @default(0)
  location              String?
  currentArrangement    String?
  tier                  String    @default("C")
  score                 Int       @default(0)
  scoreReason           String?
  overrideTier          String?
  urgency               Int       @default(3)
  affordability         Int       @default(3)
  serviceFrequency      Int       @default(3)
  decisionMakerAccess   Boolean   @default(false)
  hasInternalService    Boolean   @default(false)
  status                Stage     @default(lead)
  archived              Boolean   @default(false)
  assignedCallerId      String?
  assignedCaller        User?     @relation("AssignedCaller", fields: [assignedCallerId], references: [id])
  backupCallerId        String?
  backupCaller          User?     @relation("BackupCaller", fields: [backupCallerId], references: [id])
  assignedCloserId      String?
  assignedCloser        User?     @relation("AssignedCloser", fields: [assignedCloserId], references: [id])
  supervisingManagerId  String?
  supervisingManager    User?     @relation("SupervisingManager", fields: [supervisingManagerId], references: [id])
  nextAction            String?
  notes                 String?
  followUpDate          DateTime?
  lastActivityAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  activities    Activity[]
  followups     Followup[]
  proposals     Proposal[]
  contracts     Contract[]
  payments      Payment[]
  meetings      Meeting[]
  scoreHistory  ScoreHistory[]
  notifications Notification[]
}

model Activity {
  id                   String   @id @default(uuid())
  prospectId           String
  prospect             Prospect @relation(fields: [prospectId], references: [id])
  callerId             String?
  caller               User?    @relation(fields: [callerId], references: [id])
  outcome              String
  decisionMakerReached Boolean  @default(false)
  notes                String?
  createdAt            DateTime @default(now())
}

model Followup {
  id         String   @id @default(uuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  type       String   @default("call")
  dueDate    DateTime
  completed  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
}

model Meeting {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id])
  scheduledAt DateTime
  type        String   @default("presentation")
  status      String   @default("scheduled")
  notes       String?
  createdAt   DateTime @default(now())
}

model Proposal {
  id                 String    @id @default(uuid())
  prospectId         String
  prospect           Prospect  @relation(fields: [prospectId], references: [id])
  fleetSize          Int?
  serviceNeeds       String?
  currentSpend       Float?
  downtimeConcerns   String?
  recommendedProgram String    @default("Stewardship Standard")
  price              Float     @default(25000)
  options            String?
  startDate          DateTime?
  paymentArrangement String?
  status             String    @default("draft")
  createdAt          DateTime  @default(now())

  contracts Contract[]
}

model Contract {
  id             String    @id @default(uuid())
  contractNumber String    @unique
  prospectId     String
  prospect       Prospect  @relation(fields: [prospectId], references: [id])
  proposalId     String?
  proposal       Proposal? @relation(fields: [proposalId], references: [id])
  amount         Float
  status         String    @default("awaiting_signature")
  signatureUrl   String?
  signedAt       DateTime?
  createdAt      DateTime  @default(now())

  payments Payment[]
}

model Payment {
  id          String    @id @default(uuid())
  prospectId  String
  prospect    Prospect  @relation(fields: [prospectId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  amount      Float
  dueDate     DateTime?
  status      String    @default("collected")
  collectedAt DateTime  @default(now())
}

model ScoreHistory {
  id             String   @id @default(uuid())
  prospectId     String
  prospect       Prospect @relation(fields: [prospectId], references: [id])
  originalScore  Int
  newScore       Int?
  originalTier   String
  newTier        String
  reason         String?
  overriddenById String?
  overriddenBy   User?    @relation(fields: [overriddenById], references: [id])
  createdAt      DateTime @default(now())
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  message    String
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id])
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model CsvImport {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  filename       String
  totalRows      Int
  successCount   Int
  failedCount    Int
  duplicateCount Int
  createdAt      DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
